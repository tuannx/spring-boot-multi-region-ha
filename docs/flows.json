    { "id": "db", "type": "database", "label": "PostgreSQL", "sublabel": "Aurora & Leases", "brand": "postgresql" },
    { "id": "rabbit", "type": "messagebus", "label": "RabbitMQ", "sublabel": "broker :5672", "brand": "rabbitmq" },
    { "id": "producer", "type": "external", "label": "Event Producer", "sublabel": "order service" }
  ],
  "segments": [
