{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Dual Message Flows: Synchronous HTTP vs Asynchronous Queue",
    "output": "flows.html",
    "viewBox": [1080, 560],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "http-sync",
        "label": "Synchronous HTTP Flow",
        "focus": ["client", "nginx", "app", "db"],
        "note": "Blocking request-response lifecycle routed by X-Source-Region to local app and Aurora writer."
      },
      {
        "id": "queue-async",
        "label": "Asynchronous Queue Flow",
        "focus": ["producer", "rabbit", "app", "db"],
        "note": "Decoupled AMQP event ingestion processed independently by regional queue listeners."
      },
      {
        "id": "dr-takeover",
        "label": "DR Queue Takeover Flow",
        "focus": ["app", "db", "rabbit"],
        "note": "When a region fails, healthy brother region acquires DB lease and drains remote broker queues."
      }
    ]
  },
  "participants": [
    { "id": "client", "type": "external", "label": "HTTP Client", "sublabel": "Browser / REST" },
